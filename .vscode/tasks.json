{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build thread tests (MSBuild /m)",
			"type": "shell",
			"command": "cmake --build build --config Debug --target test_thread_pool test_thread_barrier -- /m:8",
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "Build sync tests (MSBuild /m)",
			"type": "shell",
			"command": "cmake --build build --config Debug --target test_sync_phase5_8_snapshot test_sync_phase5_8_delta test_sync_phase5_8_tx test_sync_phase5_8_rollback test_sync_phase5_8_integration -- /m:8",
			"problemMatcher": [
				"$msCompile"
			],
			"group": "build"
		},
		{
			"label": "Build Debug (SDL2, -j12) quick check",
			"type": "shell",
			"command": "cmake --build build --config Debug --parallel 12"
		},
		{
			"label": "Run ctests (SDL, -j12) verify no regression",
			"type": "shell",
			"command": "ctest --test-dir . -C Debug -j 12 --output-on-failure"
		}
	]
}
